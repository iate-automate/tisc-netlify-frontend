---
import { prettyDate } from "@/functions/server/utils"
import PageHeader from "@/components/Elements/PageHeader/PageHeader.astro"
import Applications from "@/components/Applications/Applications"

const { applications } = Astro.props
const title = applications?.[0]?.["Course Title"]
const courseId = applications?.[0]?.["Course ID"]
const date = prettyDate(applications?.[0]?.["Start Date"])
const count = applications?.length

// Sort applications by name
const sortedApplications = applications
    .filter((application: any) => {
        const fullName = application["Full Name"]?.[0] || ""
        if (!fullName || fullName.trim() === "") {
            console.warn("Skipping application with missing Full Name:", application["Record ID"] || "unknown")
            return false
        }
        return true
    })
    .sort((a: any, b: any) => {
        const nameA = a["Full Name"]?.[0] || ""
        const nameB = b["Full Name"]?.[0] || ""
        return nameA.localeCompare(nameB)
    })

---

{applications[0] ?
    <PageHeader title={title} />
    <div class="meta">
        <div><strong>Course</strong></div><div>{courseId}</div>
        <div><strong>Start Date</strong></div><div>{date}</div>
        <div><strong>Delegates</strong></div><div>{count}</div>
    </div>
    <div class="data">
    {sortedApplications.map((application: any, index: number) => (
        <Applications
            id={index.toString()}
            name={application["Full Name"]}
            role={application["Role"]}
            email={application["Email"]}
            phone={application["Phone"]}
            org={application["Feed Organisation"]}
            responses={application["Form Responses"]}
            trauma={application["Trauma Record"]}
            client:only="react"
        />
    ))}
</div>
:
    <div>
        <h1>Oops!</h1>
        <p class="block">It looks like either there aren't any applications for that course or that link is broken. If you need any help please contact the TISUK team.</p>
    </div>
}

<style>
     h2 {
        font-size: 1rem;
    }

    .meta {
        display: grid;
        grid-template-columns: max-content auto;
        gap: 0 var(--margin-medium);
    }
</style>
