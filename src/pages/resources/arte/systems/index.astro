---
import settings from '@/settings'
import Master from '@/layouts/Master.astro'
import Breadcrumb from '@/components/Elements/Breadcrumb.astro'
import GallerySystems from '@/components/Resources/ARTE/GallerySystems.astro'
import ButtonBack from '@/components/Elements/Buttons/ButtonBack'
import Loader from '@/components/Elements/Loader/Loader.astro'

---

<Master title="Systems">
	<section class="section__resources">
		
		<Breadcrumb
			section={"Resources"}
			sectionUrl={"/resources"}
			title={settings.resources["ARTE"].title}
			links={settings.resources["ARTE"].breadcrumb}
		/>
		
		 <!-- Header -->
		<div class="header__resources">
			<ButtonBack
				label="< Back"
				variant="alt"
				style="link"
				client:only="react"
			/>
			<h1>Systems</h1>
		</div>
		
		<GallerySystems server:defer >
			<Loader slot="fallback" label="Loading Systems..."/>
		</GallerySystems>
		

		 <!-- Back -->
         <div>
            <ButtonBack
                label="Back"
                variant="alt"
				style="button"
                client:only="react"
            />
        </div>

	</section>
</Master>
